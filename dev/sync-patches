#!/usr/bin/env bash
# sync-patches — regenerate patches/ and net-new src/ in THIS repo from the
# working trees, so packaging/reproduce.sh (clone BASE -> apply series -> build)
# reproduces exactly what was tested. Run before every commit of a code change.
# Does NOT commit — prints a git-status summary for you to review.
#
# Anchors (env.sh): committed commits -> numbered patches via format-patch;
# uncommitted WIP -> a single trailing wip patch via git diff.
source "$(dirname "$(readlink -f "$0")")/env.sh"

fmt() { # tree base outdir   -> numbered patches for committed commits
    git -C "$1" format-patch "$2..HEAD" -o "$3" -q
}
diffto() { # tree outfile [pathspec...]  -> uncommitted tracked diff
    local t="$1" o="$2"; shift 2
    git -C "$t" diff -- "$@" > "$o"
}

say "mesa: 0001,0002 (committed) + 0003 (wip)"
fmt "$MESA_TREE" "$MESA_BASE" "$REPO/patches/mesa"
diffto "$MESA_TREE" "$REPO/patches/mesa/0003-wip-ahb-memory-steering.patch"

say "virglrenderer: 0001-0005 (committed) + 0006 (wip) + net-new src"
fmt "$VIRGL_TREE" "$VIRGL_BASE" "$REPO/patches/virglrenderer"
# 0006 = tracked WIP only (untracked gpu-alloc files are shipped as net-new src)
diffto "$VIRGL_TREE" "$REPO/patches/virglrenderer/0006-wip-gpu-alloc-and-global-priority.patch"
cp "$VIRGL_TREE/vtest/vtest_gpu_alloc.c" "$REPO/src/virglrenderer-vtest/"
cp "$VIRGL_TREE/vtest/vtest_gpu_alloc.h" "$REPO/src/virglrenderer-vtest/"
[ -f "$VIRGL_TREE/vtest/vtest_alloc_formats.h" ] && cp "$VIRGL_TREE/vtest/vtest_alloc_formats.h" "$REPO/src/"

say "hwcomposer: 0001-wip-nvidia-fixes (all uncommitted)"
diffto "$HWC_TREE" "$REPO/patches/hwcomposer/0001-wip-nvidia-fixes.patch"

say "waydroid: 0001-nvidia-integration (uncommitted gpu.py + lxc.py + hardware_manager.py + session_manager.py)"
# The runtime waydroid is the Fedora package's root-owned /usr/lib/waydroid, so
# `git -C` there cannot run; WAYDROID_PATCH_TREE is a pristine git checkout of
# the same upstream.  Diff pristine-vs-runtime with --no-index (readable as
# root-owned) and rewrite the a/ b/ prefixes onto the upstream paths so the
# result still applies with `git apply` after a fresh clone.
#
# The pristine tree MUST be the pinned SHA from packaging/ci/pins.env -- that is
# the commit CI applies the patch to.  Diffing against upstream main instead
# sweeps the distribution's own local modifications (Fedora's Mali
# ro.vendor.arm.egl.* block in lxc.py, for one) into the patch as deletions of
# lines the pinned base never had, and `git apply` then fails there with
# "patch does not apply" -- which is exactly how the lxc.py:324 hunk broke.
: "${WAYDROID_PATCH_SHA:=$(sed -n 's/^WAYDROID_SHA=//p' "$REPO/packaging/ci/pins.env")}"
[ -n "$WAYDROID_PATCH_SHA" ] || {
    echo "sync-patches: no WAYDROID_SHA in packaging/ci/pins.env" >&2; exit 1; }
if [ "$(git -C "$WAYDROID_PATCH_TREE" rev-parse HEAD 2>/dev/null || echo none)" != "$WAYDROID_PATCH_SHA" ]; then
    echo "sync-patches: checking out pinned waydroid base $WAYDROID_PATCH_SHA in $WAYDROID_PATCH_TREE"
    git -C "$WAYDROID_PATCH_TREE" fetch -q --depth 1 origin "$WAYDROID_PATCH_SHA"
    git -C "$WAYDROID_PATCH_TREE" checkout -q "$WAYDROID_PATCH_SHA"
fi
WAYDROID_PATHS=(
    tools/helpers/gpu.py
    tools/helpers/lxc.py
    tools/services/hardware_manager.py
    tools/actions/session_manager.py
    tools/actions/container_manager.py
)
git diff --no-index --src-prefix=a/ --dst-prefix=b/ \
    -- "$WAYDROID_PATCH_TREE" "$WAYDROID_SRC" -- "${WAYDROID_PATHS[@]}" \
    2>/dev/null \
  | sed -e "s#a$WAYDROID_PATCH_TREE/#a/#g" -e "s#b$WAYDROID_SRC/#b/#g" \
  > "$REPO/patches/waydroid/0001-nvidia-integration.patch" || true
# --no-index exits 1 when there are differences; an empty result means the two
# trees are identical, which must not silently ship a zero-byte patch.
[ -s "$REPO/patches/waydroid/0001-nvidia-integration.patch" ] || {
    echo "sync-patches: waydroid patch came out EMPTY -- $WAYDROID_PATCH_TREE" \
         "and $WAYDROID_SRC look identical; refusing to ship a no-op patch." >&2
    exit 1
}
# Refuse to ship a patch that cannot be applied at the pinned base CI uses.
if ! git -C "$WAYDROID_PATCH_TREE" apply --check \
        "$REPO/patches/waydroid/0001-nvidia-integration.patch" 2>/dev/null; then
    echo "sync-patches: the generated waydroid patch does NOT apply at pinned base" \
         "$WAYDROID_PATCH_SHA; it would break CI. Not shipping it." >&2
    exit 1
fi

echo
say "review (nothing committed):"
git -C "$REPO" status --short patches/ src/
echo
echo "diff summary:"; git -C "$REPO" diff --stat patches/ src/ | tail -20
echo
echo "if it looks right:  git -C $REPO add -A patches/ src/ && git -C $REPO commit"
