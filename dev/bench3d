import json, os, re, sys, csv
art, label, size, elapsed = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
out = {"label": label, "zip_size": size, "elapsed_s": elapsed, "artifacts": art}
def rdf(p):
    try: return open(p, errors="replace").read()
    except Exception: return ""
# --- raw_result.json ---
rpath = os.path.join(art, "unpacked", "raw_result.json")
out["has_raw_result"] = os.path.exists(rpath)
if out["has_raw_result"]:
    txt = rdf(rpath)
    out["raw_result_bytes"] = len(txt)
    try:
        d = json.loads(txt)
    except Exception as e:
        d = None; out["raw_parse_error"] = str(e)
    if d is not None:
        hits = []
        def walk(o, path=""):
            if isinstance(o, dict):
                for k, v in o.items():
                    p = path + "/" + k
                    if isinstance(v, (int, float, str)) and re.search(r"score|fps|rate|error|status|result|time|duration|abort", k, re.I):
                        hits.append((p, v))
                    walk(v, p)
            elif isinstance(o, list):
                for i, v in enumerate(o[:12]): walk(v, path + "/%d" % i)
        walk(d)
        out["raw_fields"] = hits[:60]
        def find_key(o, key):
            if isinstance(o, dict):
                for k, v in o.items():
                    if k.lower() == key and not isinstance(v, (dict, list)):
                        return v
                    r = find_key(v, key)
                    if r is not None: return r
            elif isinstance(o, list):
                for v in o:
                    r = find_key(v, key)
                    if r is not None: return r
            return None
        # the Vulkan device identity is THE pass/fail discriminator
        for k in ("devicename", "detailedmessage", "swapchainresolution", "resolution", "fps", "primaryresult"):
            out["rk_" + k] = find_key(d, k)
# --- Arielle.xml ---
a = rdf(os.path.join(art, "unpacked", "Arielle.xml"))
if a:
    out["arielle_bytes"] = len(a)
    m = re.search(r"<run_errors[^>]*status=\"([^\"]*)\"", a)
    out["run_errors_status"] = m.group(1) if m else None
    m = re.search(r"<execution_state fsm_state=\"([^\"]*)\"", a)
    out["fsm_state"] = m.group(1) if m else None
    codes = re.findall(r"<status code=\"([^\"]*)\"", a)
    out["status_codes"] = codes
    m = re.search(r"<primary_result[^>]*>([^<]*)</primary_result>", a)
    out["primary_result"] = m.group(1) if m else None
    m = re.search(r"<setting>\s*<name>rendering_resolution</name>\s*<value>([^<]*)</value>", a)
    out["rendering_resolution"] = m.group(1) if m else None
# --- Result.xml ---
r = rdf(os.path.join(art, "unpacked", "Result.xml"))
if r:
    out["result_xml_scores"] = re.findall(r"<(SteelNomad[A-Za-z0-9]*Score[A-Za-z0-9]*)>([^<]*)</\1>", r)
# --- Monitoring.csv ---
mp = os.path.join(art, "unpacked", "Monitoring.csv")
if os.path.exists(mp):
    rows = list(csv.reader(open(mp, errors="replace")))
    out["monitoring_rows"] = len(rows) - 1
    if rows:
        hdr = rows[0]
        try:
            fi = hdr.index("BM/FramesPerSecond:I1000"); ei = hdr.index("BM/Events:E"); ri = hdr.index("BM/RunTimeSeconds:E")
            ev = [(rw[ri], rw[ei]) for rw in rows[1:] if len(rw) > ei and rw[ei].strip()]
            fps = [rw[fi] for rw in rows[1:] if len(rw) > fi and rw[fi].strip()]
            out["monitoring_events"] = ev
            out["monitoring_fps_samples"] = len(fps)
            out["monitoring_run_end_s"] = rows[-1][ri] if len(rows[-1]) > ri else None
        except ValueError:
            pass
# --- gpu.csv ---
gp = os.path.join(art, "gpu.csv")
if os.path.exists(gp):
    U, SM, MEM, PW = [], [], [], []
    gens = {}
    for line in open(gp, errors="replace"):
        p = [x.strip() for x in line.split(",")]
        if len(p) < 10: continue
        try:
            u, um, sm, mem, pw, tg, gen, w, mu = (int(p[1]), int(p[2]), int(p[3]), int(p[4]),
                                                  float(p[5]), int(p[6]), p[7], p[8], int(p[9]))
        except ValueError:
            continue
        U.append(u); SM.append(sm); MEM.append(mem); PW.append(pw)
        gens[gen] = gens.get(gen, 0) + 1
    if U:
        out["gpu"] = {"samples": len(U), "peak_util": max(U), "mean_util": sum(U) // len(U),
                      "peak_sm_mhz": max(SM), "peak_mem_mhz": max(MEM), "max_power_w": max(PW),
                      "pcie_gen_hist": gens}
# --- logcat signal ---
lp = os.path.join(art, "logcat.txt")
if os.path.exists(lp):
    pats = {"Xid": r"\bXid\b|fallen off the bus|RmInitAdapter failed", "DEVICE_LOST": r"DEVICE_LOST|device lost",
            "VK_ERROR": r"VK_ERROR", "vulkan": r"vulkan|vkCreate|vkAllocate",
            "gralloc": r"gralloc", "nvgralloc": r"nvgralloc|NvGralloc",
            "nvk": r"\bNVK\b|nvkmd|nvidia-prolapse", "virgl_venus": r"virgl|venus",
            "lowmemorykiller": r"lowmemorykiller|lmkd.*kill|Killing.*to free",
            "FATAL": r"FATAL EXCEPTION", "ANR": r"ANR in |not responding|Input dispatching timed out",
            "am_crash": r"am_crash|am_anr|am_proc_died", "tombstone": r"tombstone|SIGSEGV|SIGABRT|signal 11",
            "workload": r"Disco|Workload|flamenco|FuturemarkError|DLC", "angle_err": r"ANGLE.*(error|fail)|EGL_BAD",
            "swiftshader": r"swiftshader|SwiftShader", "surfaceflinger_err": r"SurfaceFlinger.*(error|fail|abort)"}
    txt = open(lp, errors="replace").read()
    sig = {}
    for k, pat in pats.items():
        ms = re.findall(r".*" + pat + r".*", txt, re.I)
        sig[k] = {"count": len(ms), "sample": [x[:200] for x in ms[:6]]}
    out["logcat_lines"] = txt.count("\n")
    out["logcat_signal"] = sig
# --- nvhal instrumentation: gputime + xlate_stats ---------------------------
nv = os.path.join(art, "nvhal")
if os.path.isdir(nv):
    blob = ""
    for fn in sorted(os.listdir(nv)):
        blob += rdf(os.path.join(nv, fn)) + "\n"
    gp = []
    pat = r"===\s*window\s+([0-9.]+)\s*ms,\s*(\d+)\s+frames\s*\(([0-9.]+)\s*fps\)[^\n]*?busy\s+([0-9.]+)\s*ms"
    for m in re.finditer(pat, blob):
        gp.append({"window_ms": float(m.group(1)), "frames": int(m.group(2)),
                   "fps": float(m.group(3)), "busy_ms": float(m.group(4))})
    out["gputime_windows"] = gp
    if gp:
        b = sorted(x["busy_ms"] for x in gp)
        wr = sorted((1000.0 / x["fps"]) if x["fps"] else 0.0 for x in gp)
        bm = b[len(b) // 2]; wm = wr[len(wr) // 2]
        out["gputime"] = {"windows": len(gp), "busy_ms_min": b[0], "busy_ms_median": bm,
                          "busy_ms_max": b[-1], "wall_ms_per_frame_median": wm,
                          "busy_over_wall_median": (bm / wm) if wm else None}
    xl = [l for l in blob.splitlines()
          if ("xlate stats" in l) or ("statistics ON" in l) or ("gputime:" in l) or ("gputime stats" in l)]
    if xl:
        out["xlate_lines"] = xl[-14:]
        pct = [float(x) for x in re.findall(r"([0-9.]+)%\s*of cpu", blob)]
        if pct:
            out["xlate_cpu_pct_max"] = max(pct); out["xlate_cpu_pct_tail"] = pct[-10:]
        usf = [float(x) for x in re.findall(r"([0-9.]+)\s*us/frame", blob)]
        if usf:
            out["xlate_us_per_frame_last"] = usf[-1]
if not out.get("gputime_windows"):
    out["gputime_windows"] = []
# --- HAL EXPERIMENT lines (hostvis_to_bar / memtypes / memstats / astc) -----
# One generic matcher: every debug.nvhal.* experiment prints "EXPERIMENT <prop>:
# ..." so a new switch never needs another parser.
expat = re.compile(r"EXPERIMENT[^\n]*")
for src, tag in ((os.path.join(art, "nvhal", "logcat-nvhal.txt"), "nvhal"),
                 (os.path.join(art, "logcat.txt"), "logcat")):
    if not os.path.exists(src):
        continue
    lines = expat.findall(rdf(src))
    if lines:
        ex = out.setdefault("experiment", {})
        ex[tag + "_lines"] = len(lines)
        ex[tag + "_sample"] = lines[:8]
        ex[tag + "_last"] = lines[-4:]
        if tag == "nvhal":
            ex["all"] = lines
# --- BAR1 / FB memory windows (before + after) ------------------------------
bars = {}
for tag in ("before", "after"):
    qp = os.path.join(art, "gpu-%s-q.txt" % tag)
    if not os.path.exists(qp):
        continue
    qt = rdf(qp)
    mb = re.search(r"BAR1 Memory Usage\s*\n\s*Total\s*:\s*(\d+)\s*MiB\s*\n\s*Used\s*:\s*(\d+)\s*MiB\s*\n\s*Free\s*:\s*(\d+)\s*MiB", qt)
    if mb:
        bars.setdefault(tag, {})["bar1"] = {"total_mib": int(mb.group(1)), "used_mib": int(mb.group(2)), "free_mib": int(mb.group(3))}
    mf = re.search(r"FB Memory Usage\s*\n\s*Total\s*:\s*(\d+)\s*MiB\s*\n\s*Reserved\s*:\s*(\d+)\s*MiB\s*\n\s*Used\s*:\s*(\d+)\s*MiB\s*\n\s*Free\s*:\s*(\d+)\s*MiB", qt)
    if mf:
        bars.setdefault(tag, {})["fb"] = {"total_mib": int(mf.group(1)), "used_mib": int(mf.group(3)), "free_mib": int(mf.group(4))}
if bars:
    out["bar1"] = bars
# --- memory-failure evidence (risk of the hostvis_to_bar A/B) ---------------
for src, tag in ((os.path.join(art, "logcat.txt"), "logcat"),
                 (os.path.join(art, "logcat-crash-tail.txt"), "crash")):
    if not os.path.exists(src):
        continue
    hits = re.findall(r".*(?:OUT_OF_DEVICE_MEMORY|OUT_OF_HOST_MEMORY|VK_ERROR_OUT_OF|ERROR_OUT_OF|DEVICE_LOST|device lost|hostvis_to_bar).*", rdf(src), re.I)
    out["mem_fail_" + tag] = {"count": len(hits), "sample": [h[:220] for h in hits[:8]]}
# --- dmon: PCIe throughput + violation counters ------------------------------
dm = {}
for fn, key in (("dmon-t.csv", "t"), ("dmon-p.csv", "p")):
    p = os.path.join(art, fn)
    if not os.path.exists(p):
        continue
    hdr = None
    rows = []
    for line in rdf(p).splitlines():
        s = line.strip()
        if not s:
            continue
        if s.startswith("#"):
            if hdr is None and not re.match(r"^#\s*Idx", s):
                hdr = s.lstrip("#").split()
            continue
        if hdr:
            parts = s.split()
            if len(parts) == len(hdr):
                rows.append(parts)
    if not hdr or not rows:
        continue
    ent = {"header": hdr, "n": len(rows)}
    for name in ("rxpci", "txpci", "pviol", "tviol", "sm", "mem", "pwr", "mclk", "fb", "bar1"):
        if name not in hdr:
            continue
        i = hdr.index(name)
        vals = []
        for r in rows:
            try:
                vals.append(float(r[i]))
            except ValueError:
                pass
        if vals:
            ent[name] = {"peak": max(vals), "mean": round(sum(vals) / len(vals), 2), "n": len(vals)}
    dm[key] = ent
if dm:
    out["dmon"] = dm
out["vram_procs"] = os.path.exists(os.path.join(art, "vram-procs.txt"))

# --- appcpu.csv: host-side CPU seconds of the 3DMark process (1 Hz) ----------
ap = os.path.join(art, "appcpu.csv")
if os.path.exists(ap):
    arows = []
    for ln in open(ap, errors="replace"):
        p = ln.strip().split(",")
        if len(p) < 5 or p[1] in ("pid", "none", ""):
            continue
        try:
            arows.append((int(p[0]), p[1], float(p[2]) + float(p[3])))
        except ValueError:
            continue
    cores = []
    for (t0, p0, c0), (t1, p1, c1) in zip(arows, arows[1:]):
        if p0 == p1 and t1 > t0 and c1 >= c0:
            cores.append((c1 - c0) / 100.0 / (t1 - t0))  # CLK_TCK=100
    if cores:
        out["appcpu"] = {"n": len(cores), "peak_cores": round(max(cores), 2),
                         "mean_cores": round(sum(cores) / len(cores), 2)}
json.dump(out, open(os.path.join(art, "summary.json"), "w"), indent=1)
g = out.get("gpu", {})
st = "FAIL"
if size > 10000: st = "OK"
print("RESULT %s score=%s size=%dB peak_util=%s%% mean_util=%s%% peak_sm=%sMHz peak_mem=%sMHz max_power=%sW elapsed=%ss %s" % (
    label, (out.get("result_xml_scores") or [[None, "?"]])[0][1] if out.get("result_xml_scores") else "?",
    size, g.get("peak_util", "-"), g.get("mean_util", "-"), g.get("peak_sm_mhz", "-"),
    g.get("peak_mem_mhz", "-"), g.get("max_power_w", "-"), elapsed, st))
print("raw_result.json present : %s" % out.get("has_raw_result"))
print("deviceName | detail     : %s | %s" % (out.get("rk_devicename"), str(out.get("rk_detailedmessage"))[:160]))
print("swapchain | resolution  : %s | %s" % (out.get("rk_swapchainresolution"), out.get("rk_resolution")))
print("run_errors status       : %s   fsm=%s" % (out.get("run_errors_status"), out.get("fsm_state")))
print("workload status codes   : %s   primary_result=%s" % (out.get("status_codes"), out.get("primary_result")))
print("monitoring rows/fps/end : %s / %s / %ss" % (out.get("monitoring_rows"), out.get("monitoring_fps_samples"), out.get("monitoring_run_end_s")))
print("monitoring events       : %s" % (out.get("monitoring_events"),))
print("pcie gen histogram      : %s" % (g.get("pcie_gen_hist"),))
print("rendering_resolution    : %s" % out.get("rendering_resolution"))
print("result.xml scores       : %s" % (out.get("result_xml_scores"),))
if out.get("bar1"):
    print("BAR1/FB memory          : %s" % json.dumps(out["bar1"]))
if out.get("dmon"):
    for k, v in out["dmon"].items():
        line = "dmon[%s] n=%s" % (k, v.get("n"))
        for name in ("rxpci", "txpci", "pviol", "tviol", "sm", "mem", "pwr", "mclk"):
            if v.get(name):
                line += " %s(peak=%s mean=%s)" % (name, v[name]["peak"], v[name]["mean"])
        print(line)
print("vram-procs.txt          : %s" % ("present" if out.get("vram_procs") else "MISSING"))
print("appcpu.csv (host CPU)   : %s" % (json.dumps(out.get("appcpu")) if out.get("appcpu") else "MISSING"))
if out.get("experiment"):
    ex = out["experiment"]
    print("EXPERIMENT lines        : nvhal=%s logcat=%s" % (ex.get("nvhal_lines"), ex.get("logcat_lines")))
    for ln in (ex.get("all") or ex.get("nvhal_sample") or ex.get("logcat_sample") or [])[:14]:
        print("    %s" % ln[:240])
else:
    print("EXPERIMENT lines        : ABSENT (props off, no matching type, or HAL did not run)")
for _t in ("logcat", "crash"):
    mf = out.get("mem_fail_" + _t)
    if mf and mf["count"]:
        print("mem-fail[%s] count=%d : %s" % (_t, mf["count"], str(mf["sample"])[:300]))
if out.get("gputime_windows"):
    print("--- nvhal gputime (busy = GPU ms/frame, wall = 1000/fps) ---")
    for x in out["gputime_windows"][-8:]:
        print("gputime win=%8.0fms frames=%-4d fps=%.2f busy=%.3fms wall/frame=%.1fms busy/wall=%.3f" % (
            x["window_ms"], x["frames"], x["fps"], x["busy_ms"],
            (1000.0 / x["fps"]) if x["fps"] else -1.0,
            (x["busy_ms"] * x["fps"] / 1000.0) if x["fps"] else -1.0))
    gsum = out.get("gputime", {})
    print("gputime summary         : %s" % (gsum,))
else:
    print("gputime windows         : none found in artifacts/nvhal/*")
for l in (out.get("xlate_lines") or [])[-4:]:
    print("nvhal[stat] %s" % (l[:200],))
if out.get("xlate_cpu_pct_max") is not None:
