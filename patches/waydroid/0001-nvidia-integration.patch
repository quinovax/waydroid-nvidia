+def _nvidia_venus_socket(args):
+    return tools.config.load(args)["waydroid"].get("nvidia_venus_socket")
+
+
+def _systemctl_user(verb, unit=VENUS_UNIT, timeout=20):
+    try:
+        return subprocess.run(
+            ["systemctl", "--user", verb, unit],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, timeout=timeout)
+    except (OSError, subprocess.TimeoutExpired) as e:
+        logging.error("systemctl --user %s %s failed: %s", verb, unit, e)
+        return None
+
+
+def start_venus(args):
+    """Restart wd-venus for this session so leftover clients cannot block SF."""
+    venus_socket = _nvidia_venus_socket(args)
+    if not venus_socket:
+        return
+    logging.info("Starting %s for this session", VENUS_UNIT)
+    result = _systemctl_user("restart")
+    if result is None or result.returncode != 0:
+        err = (result.stderr or result.stdout or "").strip() if result else "systemctl failed"
+        logging.error("Could not start %s: %s", VENUS_UNIT, err)
+        logging.error("Is the waydroid-nvidia user unit installed?")
+        sys.exit(1)
+    last_err = None
+    for _ in range(25):
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            sock.settimeout(0.5)
+            sock.connect(venus_socket)
+            return
+        except OSError as e:
+            last_err = e
+            time.sleep(0.2)
+        finally:
+            sock.close()
+    why = last_err.strerror if last_err is not None else "unknown error"
+    logging.error("Venus render server socket '%s' is not accepting connections (%s).",
+                  venus_socket, why)
+    sys.exit(1)
+
+
+def stop_venus(args):
+    """Stop wd-venus with the session so the next start is a clean renderer."""
+    if not _nvidia_venus_socket(args):
+        return
+    logging.info("Stopping %s with the session", VENUS_UNIT)
+    _systemctl_user("stop")
+
