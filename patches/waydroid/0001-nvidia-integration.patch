     tools.helpers.run.user(args, command)
-    if get_apparmor_status(args):
+    if not lxc_supports_apparmor():
+        # config_3 ships `lxc.apparmor.profile = unconfined`. Strip every
+        # AppArmor key so liblxc built without HAVE_APPARMOR can parse the file.
+        command = ["sed", "-i", "-E", "/lxc\\.aa_profile|lxc\\.apparmor\\./d", lxc_path + "/config"]
+        tools.helpers.run.user(args, command)
+    elif get_apparmor_status(args):
         command = ["sed", "-i", "-E", "/lxc.aa_profile|lxc.apparmor.profile/ s/unconfined/{}/g".format(LXC_APPARMOR_PROFILE), lxc_path + "/config"]
         tools.helpers.run.user(args, command)
 
