     return nodes
 
 LXC_APPARMOR_PROFILE = "lxc-waydroid"
+
+def lxc_supports_apparmor():
+    """True iff liblxc was built with AppArmor.
+
+    Fedora/RHEL (and some other SELinux distros) ship liblxc without
+    AppArmor. Their parser returns EINVAL for `lxc.apparmor.profile`, so
+    leaving the stock `unconfined` line in the generated config makes
+    `lxc-start` refuse to load it (waydroid#1495, waydroid-nvidia#6).
+    Kernel AppArmor being enabled is irrelevant — the key itself is invalid.
+    """
+    for lib in (
+        "/usr/lib64/liblxc.so.1",
+        "/usr/lib/liblxc.so.1",
+        "/usr/lib/x86_64-linux-gnu/liblxc.so.1",
+        "/usr/lib/aarch64-linux-gnu/liblxc.so.1",
+    ):
+        if not os.path.exists(lib):
+            continue
+        try:
+            out = subprocess.check_output(
+                ["ldd", lib], text=True, stderr=subprocess.DEVNULL)
+            return "libapparmor.so" in out
+        except (OSError, subprocess.CalledProcessError):
+            return False
+    return False
+
 def get_apparmor_status(args):
     enabled = False
     if shutil.which("aa-enabled"):
