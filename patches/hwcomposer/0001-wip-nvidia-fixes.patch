+/* Solid-color parent buffer at the configured window size.
+ * A 1×1 SHM texel stretched with wp_viewport is compositor-dependent:
+ * Denial (NVIDIA EGL) treats a fully-transparent 1×1 as empty and fills
+ * the xdg_toplevel with default white, which hid AnTuTu 3D subsurfaces
+ * during 测评 (host window ~92% white vs guest SF content). */
+static struct wl_buffer *
+create_solid_shm_buffer(struct display *display, int width, int height, hwc_color_t color)
+{
+    if (width <= 0)
+        width = 1;
+    if (height <= 0)
+        height = 1;
+    const size_t n = (size_t)width * (size_t)height;
+    const size_t bytes = n * 4;
+    if (bytes > (size_t)INT32_MAX) {
+        ALOGE("background %dx%d exceeds wl_shm pool", width, height);
+        return nullptr;
+    }
+    int fd = syscall(SYS_memfd_create, "waydroid-bg", 0);
+    if (fd < 0 || ftruncate(fd, (off_t)bytes) < 0) {
+        ALOGE("background memfd failed: %s", strerror(errno));
+        if (fd >= 0)
+            close(fd);
+        return nullptr;
+    }
+    void *data = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        ALOGE("background mmap failed");
+        close(fd);
+        return nullptr;
+    }
+    uint32_t pixel = ((uint32_t)color.a << 24) | ((uint32_t)color.r << 16) |
+                     ((uint32_t)color.g << 8) | (uint32_t)color.b;
+    if (pixel == 0) {
+        memset(data, 0, bytes);
+    } else {
+        uint32_t *pixels = static_cast<uint32_t *>(data);
+        for (size_t i = 0; i < n; i++)
+            pixels[i] = pixel;
+    }
+    struct wl_shm_pool *bg_pool = wl_shm_create_pool(display->shm, fd, (int32_t)bytes);
+    close(fd);
+    munmap(data, bytes);
+    struct wl_buffer *buf = wl_shm_pool_create_buffer(bg_pool, 0, width, height,
+                                                      width * 4, WL_SHM_FORMAT_ARGB8888);
+    wl_shm_pool_destroy(bg_pool);
+    return buf;
+}
