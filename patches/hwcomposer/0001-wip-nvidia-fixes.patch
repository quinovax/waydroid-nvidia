+/* NVIDIA EGL binds LINEAR dma_bufs only as GL_TEXTURE_EXTERNAL_OES.
+ * Mutter/Cogl and KWin sample Wayland buffers as GL_TEXTURE_2D, so attaching
+ * a LINEAR buffer is a fatal zwp_linux_buffer_params error 7
+ * ("Could not bind the given EGLImage to a CoglTexture2D") — Shiro836#11.
+ * The compositor still *advertises* LINEAR, so a naive format+modifier check
+ * is not enough. If it also advertises any NVIDIA vendor modifier, it is
+ * compositing on NVIDIA: force LINEAR layers through SurfaceFlinger. Hybrid
+ * iGPU compositors advertise Intel/AMD modifiers, not NVIDIA 0x03, so LINEAR
+ * (the hybrid present path) still attaches. */
+bool compositor_uses_nvidia_egl(display *display) {
+    static int cached = -1;
+    if (cached >= 0)
+        return cached != 0;
+    for (const auto &kv : display->modifiers) {
+        for (uint64_t m : kv.second) {
+            if (fourcc_mod_get_vendor(m) == DRM_FORMAT_MOD_VENDOR_NVIDIA) {
+                cached = 1;
+                ALOGI("compositor advertises NVIDIA modifiers; LINEAR dmabufs "
+                      "will be client-composited (cannot bind as TEXTURE_2D)");
+                return true;
+            }
+        }
+    }
+    cached = 0;
+    return false;
+}
+
+bool compositor_supports(display *display, uint32_t drm_format, uint64_t modifier) {
+    if (modifier == DRM_FORMAT_MOD_INVALID)
+        return false;
+    if (modifier == DRM_FORMAT_MOD_LINEAR && compositor_uses_nvidia_egl(display))
+        return false;
+    auto it = display->modifiers.find(drm_format);
+    if (it == display->modifiers.end())
+        return false;
+    const auto &mods = it->second;
+    return std::find(mods.begin(), mods.end(), modifier) != mods.end();
