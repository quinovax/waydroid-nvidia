+/* Export a sync_file of a materialized timeline point with local syncobj
+ * ioctls only — zero socket traffic.  Returns the fd, or < -1 to make the
+ * caller fall back to the socket export.
+ */
+static int
+vtest_timeline_export_sync_file(struct vtest *vtest, uint64_t point)
+{
+   const int node_fd = vtest->timeline.node_fd;
+
+   /* wait for the host to materialize the point (QueueSubmit + import);
+    * the real GPU wait stays with the consumer of the sync_file
+    */
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   struct drm_syncobj_timeline_wait wait = {
+      .handles = (uintptr_t)&vtest->timeline.handle,
+      .points = (uintptr_t)&point,
+      .timeout_nsec = (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec +
+                      1000ll * 1000 * 1000,
+      .count_handles = 1,
+      /* WAIT_FOR_SUBMIT is required to block on a not-yet-materialized
+       * point (without it the kernel returns -EINVAL immediately);
+       * WAIT_AVAILABLE makes the wait end at materialization instead of
+       * signal
+       */
+      .flags = DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT |
+               DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE,
+   };
+   if (ioctl(node_fd, DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT, &wait))
+      return -ENOTSUP;
+
+   struct drm_syncobj_create create = { 0 };
+   if (ioctl(node_fd, DRM_IOCTL_SYNCOBJ_CREATE, &create))
+      return -ENOTSUP;
+
+   struct drm_syncobj_transfer xfer = {
+      .src_handle = vtest->timeline.handle,
+      .dst_handle = create.handle,
+      .src_point = point,
+   };
+   struct drm_syncobj_handle export = {
+      .handle = create.handle,
+      .flags = DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE,
+   };
+   const bool ok = !ioctl(node_fd, DRM_IOCTL_SYNCOBJ_TRANSFER, &xfer) &&
+                   !ioctl(node_fd, DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD, &export);
+
+   struct drm_syncobj_destroy destroy = { .handle = create.handle };
+   ioctl(node_fd, DRM_IOCTL_SYNCOBJ_DESTROY, &destroy);
+
+   return ok ? export.fd : -ENOTSUP;
+}
