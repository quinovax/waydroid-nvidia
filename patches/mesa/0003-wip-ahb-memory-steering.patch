+/* hand a sync_file to the server to become the semaphore's temporary
+ * payload; the server dups the fd (SCM_RIGHTS) so the caller keeps
+ * ownership.  The reply orders the import before later ring submissions.
+ */
+static VkResult
+vtest_semaphore_import_sync_fd(struct vn_renderer *renderer,
+                               uint64_t device_id,
+                               uint64_t semaphore_id,
+                               int sync_file_fd)
+{
+   struct vtest *vtest = (struct vtest *)renderer;
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   const uint32_t cmd[4] = {
+      (uint32_t)device_id,
+      (uint32_t)(device_id >> 32),
+      (uint32_t)semaphore_id,
+      (uint32_t)(semaphore_id >> 32),
+   };
+
+   mtx_lock(&vtest->sock_mutex);
+   vtest_hdr[VTEST_CMD_LEN] = ARRAY_SIZE(cmd);
+   vtest_hdr[VTEST_CMD_ID] = VCMD_SEMAPHORE_IMPORT_SYNC_FD;
+   /* Must not abort(): a dying renderer (NVIDIA DEVICE_LOST restarts
+    * wd-venus) used to SIGABRT Unreal's RHIThread and SurfaceFlinger. */
+   if (!vtest_write_ok(vtest, vtest_hdr, sizeof(vtest_hdr)) ||
+       !vtest_write_ok(vtest, cmd, sizeof(cmd)) ||
+       vtest_send_fd(vtest, sync_file_fd) ||
+       !vtest_read_ok(vtest, vtest_hdr, sizeof(vtest_hdr))) {
+      mtx_unlock(&vtest->sock_mutex);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   if (vtest_hdr[VTEST_CMD_ID] != VCMD_SEMAPHORE_IMPORT_SYNC_FD) {
+      mtx_unlock(&vtest->sock_mutex);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   uint32_t status;
+   if (!vtest_read_ok(vtest, &status, sizeof(status))) {
+      mtx_unlock(&vtest->sock_mutex);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   mtx_unlock(&vtest->sock_mutex);
+
+   return status ? VK_ERROR_INVALID_EXTERNAL_HANDLE : VK_SUCCESS;
+}
