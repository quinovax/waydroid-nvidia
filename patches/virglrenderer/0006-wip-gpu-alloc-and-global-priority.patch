+void
+vkr_queue_telemetry_record(struct vkr_queue *queue,
+                           uint32_t submit_count,
+                           const VkSubmitInfo *submits)
+{
+   struct vkr_cmd_stats sum = { 0 };
+   uint32_t cb_count = 0;
+   struct vkr_telem_trace_acc trace = { 0 };
+
+   /* pSubmits still holds the guest-encoded (host-pointer) command-buffer
+    * handles here — read the per-cb stats before the replace helper swaps
+    * them for real VkCommandBuffer handles. */
+   for (uint32_t i = 0; i < submit_count; i++) {
+      for (uint32_t j = 0; j < submits[i].commandBufferCount; j++)
+         vkr_telem_accum_cb(&sum, &cb_count, &trace, submits[i].pCommandBuffers[j]);
+   }
+
+   vkr_telem_store(queue, cb_count, &sum, &trace);
+
+   vkr_telem_check_dump_request();
+}
+
+static void
+vkr_telem_dump_trace(const struct vkr_draw_trace_entry *trace, uint32_t trace_n)
+{
+   if (!trace || !trace_n)
+      return;
+   const uint32_t cnt = trace_n < VKR_DRAW_TRACE_N ? trace_n : VKR_DRAW_TRACE_N;
+   for (uint32_t i = 0; i < cnt; i++) {
+      const struct vkr_draw_trace_entry *t = &trace[i];
+      switch (t->type) {
+      case 0:
+         vkr_log("    draw vc=%u inst=%u firstV=%u firstI=%u",
+                 t->p[0], t->p[1], t->p[2], t->p[3]);
+         break;
+      case 1:
+         vkr_log("    drawIdx idxC=%u inst=%u firstIdx=%u vertOff=%u",
+                 t->p[0], t->p[1], t->p[2], t->p[3]);
+         break;
+      case 2:
+         vkr_log("    dispatch %ux%ux%u", t->p[0], t->p[1], t->p[2]);
+         break;
+      case 3:
+         vkr_log("    bindPipeline pl=0x%08x bp=%u", t->p[0], t->p[1]);
+         break;
+      case 4:
+         vkr_log("    drawIndirect off=%u cnt=%u stride=%u", t->p[0], t->p[1], t->p[2]);
+         break;
+      case 5:
+         vkr_log("    drawIdxIndirect off=%u cnt=%u stride=%u", t->p[0], t->p[1], t->p[2]);
+         break;
+      case 6:
+         vkr_log("    dispatchIndirect off=%u", t->p[0]);
+         break;
+      case 7:
+         vkr_log("    setViewport w=%u h=%u x=%u y=%u",
+                 t->p[0], t->p[1], t->p[2], t->p[3]);
+         break;
+      case 8:
+         vkr_log("    setScissor w=%u h=%u x=%u y=%u",
+                 t->p[0], t->p[1], t->p[2], t->p[3]);
+         break;
+      default:
+         vkr_log("    unknown-cmd type=%u", t->type);
+         break;
+      }
+   }
+}
+
+void
+vkr_queue_telemetry_dump(void)
+{
+   const uint32_t idx = __atomic_load_n(&vkr_telem_idx, __ATOMIC_RELAXED);
+   const uint32_t n = idx < VKR_TELEM_RING ? idx : VKR_TELEM_RING;
+   const uint32_t start = idx - n;
+
+   vkr_log("== Xid-69 telemetry: %u most recent submissions (oldest first) ==", n);
+   for (uint32_t i = 0; i < n; i++) {
+      const struct vkr_telem_entry *e =
+         &vkr_telem_ring[(start + i) % VKR_TELEM_RING];
+      vkr_log("  submit #%" PRIu64 " ctx=%u cb=%u draw=%u di=%u drI=%u diI=%u "
+              "disp=%u dispI=%u",
+              e->seq, e->ctx_id, e->cb_count, e->stats.draw, e->stats.draw_indexed,
+              e->stats.draw_indirect, e->stats.draw_indexed_indirect,
+              e->stats.dispatch, e->stats.dispatch_indirect);
+   }
+
+   /* Print the exact draw/dispatch parameter stream for the last few
+    * submissions so the faulting GPU draw can be identified directly.
+    * The trace was snapshotted at submit time (see vkr_telem_store). */
+   const uint32_t detail = n < 6 ? n : 6;
+   vkr_log("-- draw-trace for the last %u submissions (oldest first) --", detail);
+   for (uint32_t i = n - detail; i < n; i++) {
+      const struct vkr_telem_entry *e =
+         &vkr_telem_ring[(start + i) % VKR_TELEM_RING];
+      vkr_log("  submit #%" PRIu64 " draw-trace (%u cmds):", e->seq, e->trace_n);
+      vkr_telem_dump_trace(e->trace, e->trace_n);
+   }
+   vkr_log("== end Xid-69 telemetry ==");
+}
