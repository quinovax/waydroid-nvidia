+/* A guest-visible GPU fault (e.g. NVIDIA Xid 69 class error under 3D load)
+ * makes THIS process's VkDevice return VK_ERROR_DEVICE_LOST.
+ *
+ * wd-venus is `--venus --multi-clients` with the default fork-per-client:
+ * virgl_test_server (systemd main PID) forks one child per guest client
+ * (SF, HWUI, Unreal, Unity, …). Killing the session leader / process group
+ * was taking down SurfaceFlinger and every other app whenever AnTuTu 3D
+ * Unreal faulted — the guest then abort()ed on the dead socket and the
+ * container looked "exited" while LXC was still RUNNING.
+ *
+ * Only this worker exits. Sibling forks keep their VkDevices. If NVIDIA
+ * really poisons the whole GPU, SF will DEVICE_LOST next and we still
+ * isolate the blast; the guest vtest path must not abort() on EOF.
+ */
+void
+vkr_context_device_lost(struct vkr_context *ctx)
+{
+   static int triggered;
+   if (__atomic_exchange_n(&triggered, 1, __ATOMIC_SEQ_CST))
+      return;
+
+   vkr_log("VK_ERROR_DEVICE_LOST: exiting this client worker only (ctx %d, %s)",
+           ctx->ctx_id, ctx->debug_name ? ctx->debug_name : "unknown");
+
+   vkr_queue_telemetry_dump();
+
+   _exit(EXIT_FAILURE);
+}
