+static int
+proxy_context_get_timeline_fd(struct virgl_context *base,
+                              int *out_syncobj_fd,
+                              int *out_node_fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+
+   const struct render_context_op_get_timeline_request req = {
+      .header.op = RENDER_CONTEXT_OP_GET_TIMELINE,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &req, sizeof(req))) {
+      proxy_log("failed to send get_timeline");
+      return -ENOTCONN;
+   }
+
+   struct render_context_op_get_timeline_reply reply;
+   int reply_fds[2] = { -1, -1 };
+   int reply_fd_count = 0;
+   if (!proxy_socket_receive_reply_with_fds(&ctx->socket, &reply, sizeof(reply),
+                                            reply_fds, 2, &reply_fd_count)) {
+      proxy_log("failed to get get_timeline reply");
+      return -ENOTCONN;
+   }
+
+   if (reply.status || reply_fd_count != 2) {
+      for (int i = 0; i < reply_fd_count; i++)
+         close(reply_fds[i]);
+      return -ENODEV;
+   }
+
+   *out_syncobj_fd = reply_fds[0];
+   *out_node_fd = reply_fds[1];
+   return 0;
+}
+
+static int
+proxy_context_import_semaphore_fd(struct virgl_context *base,
+                                  uint64_t device_id,
+                                  uint64_t semaphore_id,
+                                  int sync_file_fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+
+   const struct render_context_op_import_semaphore_request req = {
+      .header.op = RENDER_CONTEXT_OP_IMPORT_SEMAPHORE,
+      .device_id = device_id,
+      .semaphore_id = semaphore_id,
+   };
+   if (!proxy_socket_send_request_with_fds(&ctx->socket, &req, sizeof(req),
+                                           &sync_file_fd, 1)) {
+      proxy_log("failed to send import_semaphore");
+      close(sync_file_fd);
+      return -ENOTCONN;
+   }
+   /* the fd has been duplicated into the request; we still own our copy */
+   close(sync_file_fd);
+
+   struct render_context_op_import_semaphore_reply reply;
+   if (!proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply))) {
+      proxy_log("failed to get import_semaphore reply");
+      return -ENOTCONN;
+   }
+
+   return reply.status ? -EINVAL : 0;
