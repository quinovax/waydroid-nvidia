+/* Per-command-buffer draw/dispatch counters for Xid-69 telemetry.  The
+ * command stream is recorded by the guest and replayed here; these counters
+ * let the queue-submit path (and the device-lost handler) report what the
+ * faulting submission actually contained, so a recurring NVIDIA class error
+ * can be attributed to a concrete Vulkan command family.  Known fingerprints
+ * so far: Class 0xC197 Offset 0x19D0 Data 0x3C (issue #10) and Class 0xC997
+ * Offset 0x274 ErrorCode 0x9C (issue #11). */
+struct vkr_cmd_stats {
+   uint32_t draw;
+   uint32_t draw_indexed;
+   uint32_t draw_indirect;
+   uint32_t draw_indexed_indirect;
+   uint32_t dispatch;
+   uint32_t dispatch_indirect;
+   uint32_t other;
+};
+
+/* Per-draw parameter trace so a recurring Xid-69 (3D class) can be pinned to
+ * the exact draw call.  type 0=draw,1=draw_indexed,2=dispatch,3=bind_pipeline. */
+struct vkr_draw_trace_entry {
+   uint8_t type;
+   uint32_t p[4];
+};
+
+#define VKR_DRAW_TRACE_N 16
+
 struct vkr_command_buffer {
    struct vkr_object base;
 
    struct vkr_device *device;
+
+   struct vkr_cmd_stats stats;
+   struct vkr_draw_trace_entry trace[VKR_DRAW_TRACE_N];
+   uint32_t trace_n;
 };
+
+static inline void
+vkr_cmd_buffer_trace(struct vkr_command_buffer *cmd, uint8_t type,
+                     uint32_t p0, uint32_t p1, uint32_t p2, uint32_t p3)
+{
+   struct vkr_draw_trace_entry *t =
+      &cmd->trace[cmd->trace_n++ % VKR_DRAW_TRACE_N];
+   t->type = type;
+   t->p[0] = p0;
+   t->p[1] = p1;
+   t->p[2] = p2;
+   t->p[3] = p3;
+}
 VKR_DEFINE_OBJECT_CAST(command_buffer, VK_OBJECT_TYPE_COMMAND_BUFFER, VkCommandBuffer)
 
+static inline void
+vkr_command_buffer_reset_stats(struct vkr_command_buffer *cmd)
+{
+   const struct vkr_cmd_stats zero = { 0 };
+   cmd->stats = zero;
+   /* The draw trace is per-recording, exactly like the stats.  Leaving
+    * trace_n to grow without bound made the Xid-69 draw-trace unusable:
+    * the ring kept stale entries from earlier recordings, so a dump either
+    * printed draws that were not in the faulting submission, or (once the
+    * buffer had been reused many times) nothing meaningful at all.
+    * Reset it together with the stats so a dump always describes the
+    * recording that was actually submitted. */
+   cmd->trace_n = 0;
+}
+
+static inline void
+vkr_command_buffer_accum_stats(const struct vkr_command_buffer *cmd,
+                               struct vkr_cmd_stats *out)
+{
+   out->draw += cmd->stats.draw;
+   out->draw_indexed += cmd->stats.draw_indexed;
+   out->draw_indirect += cmd->stats.draw_indirect;
+   out->draw_indexed_indirect += cmd->stats.draw_indexed_indirect;
+   out->dispatch += cmd->stats.dispatch;
+   out->dispatch_indirect += cmd->stats.dispatch_indirect;
+   out->other += cmd->stats.other;
+}
