+/* Xid-69 command-stream telemetry ring.  Every vkQueueSubmit records a
+ * summary of the draw/dispatch command families in the submitted command
+ * buffers; the device-lost handler dumps the ring so a recurring NVIDIA
+ * class error can be attributed to the submission (and command family) that
+ * faulted on the GPU.  At least two fingerprints are known: the skiagl/ANGLE
+ * one this was written for (Xid 69, Class 0xC197 Offset 0x19D0 Data 0x3C,
+ * issue #10) and a second, independent one with correct props
+ * (Class 0xC997 Offset 0x274 ErrorCode 0x9C, issue #11).  Both land here --
+ * the ring is per-submission, so no fingerprint-specific code is needed.
+ */
+struct vkr_telem_entry {
+   uint64_t seq;
+   uint32_t ctx_id;
+   uint32_t cb_count;
+   struct vkr_cmd_stats stats;
+   /* The draw trace is COPIED here, not referenced.  Storing a
+    * struct vkr_command_buffer * and dereferencing it in the device-lost
+    * handler was unsafe and useless: the app resubmits every frame and
+    * command buffers/pools get reset and recycled, so by fault time the
+    * pointer either dangled (use-after-free) or pointed at a buffer whose
+    * trace had already been reset.  That is why the draw-trace never
+    * printed anything for reporters. */
+   struct vkr_draw_trace_entry trace[VKR_DRAW_TRACE_N];
+   uint32_t trace_n;
+};
+
+#define VKR_TELEM_RING 64
+static struct vkr_telem_entry vkr_telem_ring[VKR_TELEM_RING];
+static uint32_t vkr_telem_idx;
+
+/* A submission can carry several command buffers, and the interesting draws
+ * are frequently NOT in the last one (the last cb is often a small/empty
+ * present or barrier-only buffer).  Taking the trace from a single
+ * "last_cb" therefore reported "draw-trace (0 cmds)" for submissions whose
+ * stats said draw=3 di=4.  Collect the trace from EVERY command buffer in
+ * the submission, in order, keeping the most recent VKR_DRAW_TRACE_N. */
+struct vkr_telem_trace_acc {
+   struct vkr_draw_trace_entry entries[VKR_DRAW_TRACE_N];
+   uint32_t n;    /* total seen (may exceed VKR_DRAW_TRACE_N) */
+};
+
+static inline void
+vkr_telem_trace_acc_add(struct vkr_telem_trace_acc *acc,
+                        const struct vkr_command_buffer *cb)
+{
+   if (!cb || !cb->trace_n)
+      return;
+   uint32_t n = cb->trace_n;
+   if (n > VKR_DRAW_TRACE_N)
+      n = VKR_DRAW_TRACE_N;
+   const uint32_t begin = cb->trace_n - n;
+   for (uint32_t i = 0; i < n; i++) {
+      acc->entries[acc->n % VKR_DRAW_TRACE_N] =
+         cb->trace[(begin + i) % VKR_DRAW_TRACE_N];
+      acc->n++;
+   }
+}
+
+static void
+vkr_telem_store(struct vkr_queue *queue, uint32_t cb_count,
+                const struct vkr_cmd_stats *sum,
+                const struct vkr_telem_trace_acc *trace)
+{
+   struct vkr_telem_entry *e =
+      &vkr_telem_ring[__atomic_fetch_add(&vkr_telem_idx, 1, __ATOMIC_RELAXED) %
+                      VKR_TELEM_RING];
+   e->seq = queue->tel_submit_seq++;
+   e->ctx_id = queue->context->ctx_id;
+   e->cb_count = cb_count;
+   e->stats = *sum;
+
+   /* Snapshot the trace now, while the command buffers are guaranteed to be
+    * alive and still describe this submission.  Storing a pointer and
+    * dereferencing it later was both unsafe (the cb is recycled) and
+    * useless (trace_n was never reset), which is why reporters saw an empty
+    * draw-trace. */
+   e->trace_n = 0;
+   if (trace && trace->n) {
+      const uint32_t n = trace->n < VKR_DRAW_TRACE_N ? trace->n : VKR_DRAW_TRACE_N;
+      const uint32_t begin = trace->n - n;
+      for (uint32_t i = 0; i < n; i++)
+         e->trace[i] = trace->entries[(begin + i) % VKR_DRAW_TRACE_N];
+      e->trace_n = n;
+   }
+}
+
+/* Accumulate the per-command-buffer stats of one guest-encoded handle (the
+ * host-pointer value is still intact pre-replace) into *sum. */
+static inline void
+vkr_telem_accum_cb(struct vkr_cmd_stats *sum, uint32_t *cb_count,
+                   struct vkr_telem_trace_acc *trace, VkCommandBuffer handle)
+{
+   struct vkr_command_buffer *cb = vkr_command_buffer_from_handle(handle);
+   if (cb) {
+      vkr_command_buffer_accum_stats(cb, sum);
+      vkr_telem_trace_acc_add(trace, cb);
+      (*cb_count)++;
+   }
+}
+
+/* Reporters had no way to inspect the ring without provoking a real
+ * device-lost, which made the telemetry untestable and left the
+ * "draw-trace never prints anything" question open.  Allow an on-demand
+ * dump: create the file named by VKR_TELEM_DUMP (default
+ * /tmp/vkr-telem-dump) and the next submit prints the ring, then the file
+ * is removed so it fires once per request.  Read-only w.r.t. driver state.
+ */
+static void
+vkr_telem_check_dump_request(void)
+{
+   static const char *path;
+   static bool inited;
+   if (!inited) {
+      path = getenv("VKR_TELEM_DUMP");
+      if (!path)
+         path = "/tmp/vkr-telem-dump";
+      inited = true;
+   }
+   if (access(path, F_OK) != 0)
+      return;
+   unlink(path);
+   vkr_queue_telemetry_dump();
+}
