+static int64_t
+vkr_timeline_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+/* Perform one sync_file -> timeline-point import.  Runs on the timeline
+ * worker (or inline if the worker failed to start); ctx->timeline handles
+ * are immutable once created, so no lock is needed here.
+ */
+static void
+vkr_context_timeline_import_one(struct vkr_context *ctx,
+                                int sync_file_fd,
+                                uint64_t timeline_point)
+{
+   const int drm_fd = ctx->timeline.drm_fd;
+   bool imported = false;
+
+   const int64_t t0 = vkr_timeline_now_ns();
+   int64_t t_ioctl = t0, t_close = t0;
+
+   if (sync_file_fd >= 0 && ctx->timeline.one_ioctl) {
+      /* one-ioctl chain-add (kernel >= 6.16): no fence replacement happens,
+       * so no prior NVIDIA fence is released synchronously in the ioctl;
+       * waiters wake on the new point before the chain GC walk runs
+       */
+      struct drm_syncobj_handle import = {
+         .handle = ctx->timeline.handle,
+         .flags = DRM_SYNCOBJ_FD_TO_HANDLE_FLAGS_IMPORT_SYNC_FILE |
+                  DRM_SYNCOBJ_FD_TO_HANDLE_FLAGS_TIMELINE,
+         .fd = sync_file_fd,
+         .point = timeline_point,
+      };
+      if (!ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE, &import)) {
+         imported = true;
+      } else if (errno == EINVAL) {
+         vkr_log("timeline: no one-ioctl timeline import (pre-6.16 kernel), "
+                 "using scratch-syncobj fallback");
+         ctx->timeline.one_ioctl = false;
+      }
+   }
+
+   if (sync_file_fd >= 0 && !imported && !ctx->timeline.one_ioctl) {
+      /* two-step fallback via the persistent scratch binary syncobj:
+       * IMPORT_SYNC_FILE replaces its fence, then transfer to the point
+       */
+      struct drm_syncobj_handle import = {
+         .handle = ctx->timeline.scratch,
+         .flags = DRM_SYNCOBJ_FD_TO_HANDLE_FLAGS_IMPORT_SYNC_FILE,
+         .fd = sync_file_fd,
+      };
+      struct drm_syncobj_transfer xfer = {
+         .src_handle = ctx->timeline.scratch,
+         .dst_handle = ctx->timeline.handle,
+         .dst_point = timeline_point,
+      };
+      imported = !ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE, &import) &&
+                 !ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_TRANSFER, &xfer);
+   }
+
+   if (!imported) {
+      /* fd < 0 = fence already signaled; also the failure fallback so the
+       * client never stalls on WAIT_AVAILABLE
+       */
+      if (sync_file_fd >= 0)
+         vkr_log("timeline: import at point %" PRIu64 " failed, signaling",
+                 timeline_point);
+      const uint64_t point = timeline_point;
+      const uint32_t handle = ctx->timeline.handle;
+      struct drm_syncobj_timeline_array signal = {
+         .handles = (uintptr_t)&handle,
+         .points = (uintptr_t)&point,
+         .count_handles = 1,
+      };
+      ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL, &signal);
+   }
+
+   t_ioctl = vkr_timeline_now_ns();
+   if (sync_file_fd >= 0)
+      close(sync_file_fd);
+   t_close = vkr_timeline_now_ns();
+
+   if (t_close - t0 > 2000000)
+      vkr_log("NVWD-TL slow import point %" PRIu64 ": ioctls %" PRId64
+              " us close %" PRId64 " us (%s)",
+              timeline_point, (t_ioctl - t0) / 1000, (t_close - t_ioctl) / 1000,
+              ctx->timeline.one_ioctl ? "one-ioctl" : "scratch");
+}
+
+static int
+vkr_context_timeline_worker(void *arg)
+{
+   struct vkr_context *ctx = arg;
+
+   mtx_lock(&ctx->timeline.mutex);
+   while (true) {
+      while (!ctx->timeline.worker.count && !ctx->timeline.worker.join)
+         cnd_wait(&ctx->timeline.worker.cond, &ctx->timeline.mutex);
+
+      struct {
+         int fd;
+         uint64_t point;
+      } jobs[ARRAY_SIZE(ctx->timeline.worker.jobs)];
+      const uint32_t count = ctx->timeline.worker.count;
+      memcpy(jobs, ctx->timeline.worker.jobs, sizeof(jobs[0]) * count);
+      ctx->timeline.worker.count = 0;
+      const bool join = ctx->timeline.worker.join;
+      cnd_broadcast(&ctx->timeline.worker.space);
+      mtx_unlock(&ctx->timeline.mutex);
+
+      for (uint32_t i = 0; i < count; i++)
+         vkr_context_timeline_import_one(ctx, jobs[i].fd, jobs[i].point);
+
+      if (join)
+         return 0;
+      mtx_lock(&ctx->timeline.mutex);
+   }
+}
+
+/* Any render node works: syncobjs are containers for driver-agnostic
+ * dma_fences and all syncobj ioctls are DRM_RENDER_ALLOW.  drm_fd == -2
+ * marks a failed earlier attempt.
+ */
+static bool
+vkr_context_timeline_ensure_locked(struct vkr_context *ctx)
+{
+   if (ctx->timeline.handle)
+      return true;
+   if (ctx->timeline.drm_fd == -2)
+      return false;
+
+   for (int minor = 128; minor < 128 + 16; minor++) {
+      char path[64];
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", minor);
+      int fd = open(path, O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+      snprintf(ctx->timeline.node_path, sizeof(ctx->timeline.node_path), "%s", path);
+
+      struct drm_get_cap cap = { .capability = DRM_CAP_SYNCOBJ_TIMELINE };
+      struct drm_syncobj_create create = { 0 };
+      struct drm_syncobj_create scratch = { 0 };
+      if (ioctl(fd, DRM_IOCTL_GET_CAP, &cap) || !cap.value ||
+          ioctl(fd, DRM_IOCTL_SYNCOBJ_CREATE, &create) ||
+          ioctl(fd, DRM_IOCTL_SYNCOBJ_CREATE, &scratch)) {
+         close(fd);
+         continue;
+      }
+
+      ctx->timeline.drm_fd = fd;
+      ctx->timeline.handle = create.handle;
+      ctx->timeline.scratch = scratch.handle;
+      ctx->timeline.one_ioctl = true;
+
+      if (cnd_init(&ctx->timeline.worker.cond) == thrd_success) {
+         if (cnd_init(&ctx->timeline.worker.space) == thrd_success) {
+            if (thrd_create(&ctx->timeline.worker.thread,
+                            vkr_context_timeline_worker, ctx) == thrd_success) {
+               ctx->timeline.worker.started = true;
+            } else {
+               cnd_destroy(&ctx->timeline.worker.space);
+               cnd_destroy(&ctx->timeline.worker.cond);
+            }
+         } else {
+            cnd_destroy(&ctx->timeline.worker.cond);
+         }
+      }
+      return true;
+   }
+
+   vkr_log("timeline: no syncobj-timeline-capable render node found");
+   ctx->timeline.drm_fd = -2;
+   return false;
+}
+
+int
+vkr_context_get_timeline_fd(struct vkr_context *ctx,
+                            int *out_syncobj_fd,
+                            int *out_node_fd)
+{
+   mtx_lock(&ctx->timeline.mutex);
+   if (!vkr_context_timeline_ensure_locked(ctx)) {
+      mtx_unlock(&ctx->timeline.mutex);
+      return -ENODEV;
+   }
+
+   /* the client also gets a render-node fd so it can perform syncobj ioctls
+    * without needing (or having permissions on) a /dev/dri node of its own —
+    * fd passing sidesteps path access entirely.
+    *
+    * This must be a FRESH open, not a dup of our fd: a dup shares the
+    * struct file (and thus the drm_file), and DRM core's
+    * drm_file_update_pid() runs mutex + synchronize_rcu (~10 ms under load)
+    * on EVERY ioctl whose caller tgid differs from the previous one — two
+    * processes alternating ioctls on one drm_file poisons both.  With a
+    * fresh file the client is its sole user after a single handover.
+    */
+   struct drm_syncobj_handle args = { .handle = ctx->timeline.handle };
+   const int ret = ioctl(ctx->timeline.drm_fd, DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD, &args);
+   if (ret) {
+      mtx_unlock(&ctx->timeline.mutex);
+      return -errno;
+   }
+
+   const int node_fd = open(ctx->timeline.node_path, O_RDWR | O_CLOEXEC);
+   mtx_unlock(&ctx->timeline.mutex);
+   if (node_fd < 0) {
+      close(args.fd);
+      return -errno;
+   }
+
+   *out_syncobj_fd = args.fd;
+   *out_node_fd = node_fd;
+   return 0;
+}
+
+void
+vkr_context_timeline_import(struct vkr_context *ctx,
+                            int sync_file_fd,
+                            uint64_t timeline_point)
+{
+   mtx_lock(&ctx->timeline.mutex);
+
+   /* nothing to do until a client has fetched the timeline */
+   if (!ctx->timeline.handle) {
+      mtx_unlock(&ctx->timeline.mutex);
+      if (sync_file_fd >= 0)
+         close(sync_file_fd);
+      return;
+   }
+
+   if (ctx->timeline.worker.started) {
+      /* full queue = 64 frames of backlog; block rather than reorder (points
+       * must land monotonically) or import inline (would bill fence releases
+       * to this thread)
+       */
+      while (ctx->timeline.worker.count == ARRAY_SIZE(ctx->timeline.worker.jobs))
+         cnd_wait(&ctx->timeline.worker.space, &ctx->timeline.mutex);
+
+      ctx->timeline.worker.jobs[ctx->timeline.worker.count].fd = sync_file_fd;
+      ctx->timeline.worker.jobs[ctx->timeline.worker.count].point = timeline_point;
+      ctx->timeline.worker.count++;
+      cnd_signal(&ctx->timeline.worker.cond);
+      mtx_unlock(&ctx->timeline.mutex);
+      return;
+   }
+
+   mtx_unlock(&ctx->timeline.mutex);
+   vkr_context_timeline_import_one(ctx, sync_file_fd, timeline_point);
+}
+
+int
+vkr_context_import_semaphore_sync_fd(struct vkr_context *ctx,
+                                     uint64_t device_id,
+                                     uint64_t semaphore_id,
+                                     int sync_file_fd)
+{
+   struct vkr_device *dev = vkr_context_get_object(ctx, device_id);
+   struct vkr_semaphore *sem = vkr_context_get_object(ctx, semaphore_id);
+   if (!dev || dev->base.type != VK_OBJECT_TYPE_DEVICE || !sem ||
+       sem->base.type != VK_OBJECT_TYPE_SEMAPHORE) {
+      /* Report *why* the lookup failed.  The original one-line message could
+       * not distinguish "no such id" from "id exists but is the wrong object
+       * type", which is the difference between a routing bug (the object was
+       * created on another context/fork) and a lifetime bug (the id was
+       * recycled).  Both were open questions in issue #11. */
+      vkr_log("import_semaphore: bad object ids dev %" PRIu64 " sem %" PRIu64
+              " (dev %s%s, sem %s%s)",
+              device_id, semaphore_id,
+              dev ? "found" : "NULL",
+              (dev && dev->base.type != VK_OBJECT_TYPE_DEVICE) ? " wrong-type" : "",
+              sem ? "found" : "NULL",
+              (sem && sem->base.type != VK_OBJECT_TYPE_SEMAPHORE) ? " wrong-type" : "");
+      close(sync_file_fd);
+      return -EINVAL;
+   }
+
+   const VkImportSemaphoreFdInfoKHR info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_FD_INFO_KHR,
+      .semaphore = sem->base.handle.semaphore,
+      .flags = VK_SEMAPHORE_IMPORT_TEMPORARY_BIT,
+      .handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT,
+      .fd = sync_file_fd,
+   };
+   VkResult result =
+      dev->proc_table.ImportSemaphoreFdKHR(dev->base.handle.device, &info);
+   if (result != VK_SUCCESS) {
+      vkr_log("import_semaphore: vkImportSemaphoreFdKHR failed %d", result);
+      close(sync_file_fd);
+      return -EINVAL;
+   }
+
+   /* success: the driver owns the fd */
+   return 0;
+}
+
+int
+vkr_context_memory_rw(struct vkr_context *ctx,
+                      uint64_t mem_id,
+                      uint64_t offset,
+                      uint64_t size,
+                      uint32_t dir,
+                      int shm_fd)
+{
+   struct vkr_device_memory *mem = vkr_context_get_object(ctx, mem_id);
+   if (!mem || mem->base.type != VK_OBJECT_TYPE_DEVICE_MEMORY) {
+      vkr_log("memory_rw: bad mem id %" PRIu64, mem_id);
+      close(shm_fd);
+      return -EINVAL;
+   }
+   if (!size || dir > 1 || offset + size < offset ||
+       offset + size > mem->allocation_size) {
+      close(shm_fd);
+      return -EINVAL;
+   }
+   if (!mem->device) {
+      close(shm_fd);
+      return -EINVAL;
+   }
+
+   void *guest = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
+   close(shm_fd);
+   if (guest == MAP_FAILED)
+      return -errno;
+
+   struct vkr_device *dev = mem->device;
+   void *host = NULL;
+   VkResult result = dev->proc_table.MapMemory(dev->base.handle.device,
+                                               mem->base.handle.device_memory,
+                                               offset, size, 0, &host);
+   if (result != VK_SUCCESS || !host) {
+      vkr_log("memory_rw: vkMapMemory failed %d", result);
+      munmap(guest, size);
+      return -EINVAL;
+   }
+
+   if (dir == 0)
+      memcpy(guest, host, size);
+   else
+      memcpy(host, guest, size);
+
+   dev->proc_table.UnmapMemory(dev->base.handle.device,
+                               mem->base.handle.device_memory);
+   munmap(guest, size);
+   return 0;
+}
