nvk: describe a 3D view of a 2D image as a depth-1 3D image

VK_IMAGE_VIEW_TYPE_3D of a VK_IMAGE_TYPE_2D image is invalid usage, but NVIDIA's
Vulkan driver accepts it and 3DMark Wild Life Extreme creates one on its second
scene load. nil's normalize_extent (descriptor.rs:261) asserts image.dim == 3D;
the panic cannot leave extern "C" nil_image_view_descriptor and aborts.
Mirror image_3d_view_as_2d_array(): hand nil a single-sampled layer as a 3D
image of depth 1 (same memory layout), with a one-time warning naming the
invalid usage. Any other 3D view of a non-3D image (multisampled, more than one
layer, 1D) fails with a logged reason and VK_ERROR_UNKNOWN, as nvk_image.c does
for invalid image parameters, instead of reaching nil's assert.
Reproducer: native/mesa/tests/nvk-3d-view-of-2d-image.c.

--- a/src/nouveau/vulkan/nvk_image_view.c
+++ b/src/nouveau/vulkan/nvk_image_view.c
@@ -87,6 +87,53 @@
    view->base_level = 0;
 }
 
+/* VK_IMAGE_VIEW_TYPE_3D of a VK_IMAGE_TYPE_2D image is invalid usage (the
+ * image/view type compatibility table in the "Image Views" chapter allows
+ * only 2D, 2D_ARRAY, CUBE and CUBE_ARRAY views of a 2D image), but NVIDIA's
+ * Vulkan driver (615.78.08) returns VK_SUCCESS for it, and 3DMark Wild Life
+ * Extreme creates such a view on its second scene load in one process.
+ * nil's descriptor builder asserts on it (descriptor.rs normalize_extent),
+ * which aborts the process, so describe the selected layer as what it is in
+ * memory: a 3D image of depth 1.  A single-sampled 2D level has z_log2 = 0
+ * tiling and one slice per level, which is exactly the layout of a depth-1
+ * 3D image, so the texture header addresses the same texels the 2D view
+ * would.  The mirror of image_3d_view_as_2d_array() above.  Only a
+ * single-sampled layer qualifies (image_2d_layer_viewable_as_3d()); any other
+ * 3D view of a non-3D image fails vkCreateImageView with a named error
+ * instead of reaching nil's assert, which also fires in release builds.
+ */
+static bool
+image_2d_layer_viewable_as_3d(const struct nil_image *image,
+                              const struct nil_view *view)
+{
+   return image->dim == NIL_IMAGE_DIM_2D &&
+          image->extent_px.depth == 1 &&
+          image->sample_layout == NIL_SAMPLE_LAYOUT_1X1 &&
+          view->view_type == NIL_VIEW_TYPE_3D &&
+          view->array_len == 1;
+}
+
+static void
+image_2d_viewed_as_3d(struct nil_image *image,
+                      struct nil_view *view,
+                      uint64_t *base_addr)
+{
+   assert(image->dim == NIL_IMAGE_DIM_2D);
+   assert(image->extent_px.depth == 1);
+   assert(image->sample_layout == NIL_SAMPLE_LAYOUT_1X1);
+   assert(view->view_type == NIL_VIEW_TYPE_3D);
+   assert(view->array_len == 1);
+
+   mesa_logw_once("vkCreateImageView: VK_IMAGE_VIEW_TYPE_3D of a "
+                  "VK_IMAGE_TYPE_2D image is invalid usage; describing "
+                  "the layer as a 3D image of depth 1");
+
+   *base_addr += (uint64_t)view->base_array_layer * image->array_stride_B;
+   image->dim = NIL_IMAGE_DIM_3D;
+   image->extent_px.array_len = 1;
+   view->base_array_layer = 0;
+}
+
 VkResult
 nvk_image_view_init(struct nvk_device *dev,
                     struct nvk_image_view *view,
@@ -186,6 +233,23 @@
          nil_view.view_type != NIL_VIEW_TYPE_3D)
          image_3d_view_as_2d_array(&nil_image, &nil_view, &base_addr);
 
+      if (nil_view.view_type == NIL_VIEW_TYPE_3D &&
+          nil_image.dim != NIL_IMAGE_DIM_3D) {
+         if (!image_2d_layer_viewable_as_3d(&nil_image, &nil_view)) {
+            mesa_loge("vkCreateImageView: VK_IMAGE_VIEW_TYPE_3D of a "
+                      "non-3D image (image dim %u, %u layer(s) viewed, "
+                      "%s) is invalid usage that cannot be described as "
+                      "a depth-1 3D image",
+                      (unsigned)nil_image.dim, nil_view.array_len,
+                      nil_image.sample_layout == NIL_SAMPLE_LAYOUT_1X1 ?
+                      "single-sampled" : "multisampled");
+            nvk_image_view_finish(dev, view);
+            return vk_errorf(dev, VK_ERROR_UNKNOWN,
+                             "Invalid image view creation parameters");
+         }
+         image_2d_viewed_as_3d(&nil_image, &nil_view, &base_addr);
+      }
+
       view->planes[view_plane].sample_layout = nil_image.sample_layout;
 
       if (view->vk.usage & (VK_IMAGE_USAGE_SAMPLED_BIT |
