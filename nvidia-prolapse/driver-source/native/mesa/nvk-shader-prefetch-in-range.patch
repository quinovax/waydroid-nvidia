nvk: Keep the program prefetch inside the program's own range.

On Ampere B and later NVK sets SET_PIPELINE_PROGRAM_PREFETCH to
DIV_ROUND_UP(header + code, 256) blocks from the program address
(nvk_shader.c:828-836), but programs are only 0x80-aligned
(nvk_shader.c:610-618) and their ranges are packed: a prefetch from a program
that starts in the middle of a 256 B block reaches into the next range, which
may hold another program or, after a recycle, bytes in flight.

The proprietary driver (libnvidia-eglcore 615.78.08, GB202) places every
program at 0x100, reserves its range rounded up to 0x100 and sets the prefetch
to that range in 256 B blocks, so a prefetch never leaves the program's own
range. Do the same on Ampere B and later: program uploads are 256 B aligned
and padded with zeros to whole blocks. The prefetch value itself is unchanged.

Not in Mesa main as of fc88667ecb8c (2026-10-15).

diff --git a/src/nouveau/vulkan/nvk_shader.c b/src/nouveau/vulkan/nvk_shader.c
index c0c586debe0c..f531176575a2 100644
--- a/src/nouveau/vulkan/nvk_shader.c
+++ b/src/nouveau/vulkan/nvk_shader.c
@@ -611,6 +611,11 @@ nvk_shader_get_hdr_size(struct nvk_device *dev, struct nvk_shader *shader)
                                            : GF100_SHADER_HEADER_SIZE;
 }
 
+/* Ampere B and later prefetch a program in blocks of this size starting at
+ * its address, SET_PIPELINE_PROGRAM_PREFETCH blocks of it.
+ */
+#define NVK_SHADER_PREFETCH_BLOCK_B 256
+
 static uint32_t
 nvk_shader_get_shader_alignment(struct nvk_device *dev)
 {
@@ -693,7 +698,20 @@ nvk_shader_upload(struct nvk_device *dev, struct nvk_shader *shader)
       total_size += shader->data_size;
    }
 
-   char *data = malloc(total_size);
+   /* Start every program at a prefetch block and reserve whole blocks, so
+    * the prefetch set in nvk_shader_fill_push() stays inside the program's
+    * own range and never covers the neighbouring one.  This is the
+    * proprietary driver's layout (libnvidia-eglcore 615.78.08 on GB202):
+    * programs at 0x100, the reserved range rounded up to 0x100 and the
+    * prefetch size equal to that range in blocks.  The padding is zero.
+    */
+   if (pdev->info.cls_eng3d >= AMPERE_B) {
+      assert(hdr_offset == 0);
+      alignment = MAX2(alignment, NVK_SHADER_PREFETCH_BLOCK_B);
+      total_size = align(total_size, NVK_SHADER_PREFETCH_BLOCK_B);
+   }
+
+   char *data = calloc(1, total_size);
    if (data == NULL)
       return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
 
@@ -836,7 +854,11 @@ nvk_shader_fill_push(struct nvk_device *dev,
          uint32_t shader_size =
             nvk_shader_get_shader_size(dev, shader, NULL, NULL, NULL);
          uint32_t shader_prefetch_size_in_blocks =
-            MIN2(DIV_ROUND_UP(shader_size, 256), 127);
+            MIN2(DIV_ROUND_UP(shader_size, NVK_SHADER_PREFETCH_BLOCK_B), 127);
+         /* Within the program's own range, see nvk_shader_upload(). */
+         assert(addr % NVK_SHADER_PREFETCH_BLOCK_B == 0);
+         assert(shader_prefetch_size_in_blocks * NVK_SHADER_PREFETCH_BLOCK_B <=
+                shader->upload_size);
          P_NVC797_SET_PIPELINE_PROGRAM_PREFETCH(p, idx,
                                                 shader_prefetch_size_in_blocks);
       }
