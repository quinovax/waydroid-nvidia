diff --git a/src/nouveau/vulkan/nvk_queue.c b/src/nouveau/vulkan/nvk_queue.c
index 4061705eb560..410dcff210a9 100644
--- a/src/nouveau/vulkan/nvk_queue.c
+++ b/src/nouveau/vulkan/nvk_queue.c
@@ -14,6 +14,7 @@
 #include "nv_push_cl9039.h"
 #include "nv_push_cl9097.h"
 #include "nv_push_cl90b5.h"
+#include "nv_push_cla097.h"
 #include "nv_push_cla0c0.h"
 #include "cla1c0.h"
 #include "nv_push_clc3c0.h"
@@ -38,7 +39,8 @@ nvk_queue_state_finish(struct nvk_device *dev,
 
 static VkResult
 nvk_queue_state_update(struct nvk_queue *queue,
-                       struct nvk_queue_state *qs)
+                       struct nvk_queue_state *qs,
+                       uint32_t shader_upload_seq)
 {
    struct nvk_device *dev = nvk_queue_device(queue);
    const struct nvk_physical_device *pdev = nvk_device_physical(dev);
@@ -73,6 +75,25 @@ nvk_queue_state_update(struct nvk_queue *queue,
          nvkmd_mem_unref(mem);
    }
 
+   /* Shader heap ranges are recycled: a destroyed shader's range is handed
+    * to the next upload, of any stage.  The GPU's instruction and program
+    * header caches are not coherent with those writes, and nothing else
+    * invalidates them (command buffers invalidate only constants,
+    * nvk_cmd_buffer_begin_graphics).  The proprietary driver
+    * (libnvidia-eglcore 615.78.08) counts committed shader uploads per device
+    * (0xd494a0) and, in the first submission on a channel after the count
+    * moved (0xd6a235), acquires the copy engine's upload semaphore and then
+    * emits INVALIDATE_SHADER_CACHES_NO_WFI with INSTRUCTION set (0xd6a503,
+    * compute class form at 0xd6a520 on channels without 3D), with no wait for
+    * idle.  nvc0 invalidates after every upload (nvc0_program.c:944-945).
+    */
+   const bool invalidate_instructions =
+      qs->shaders.upload_seq != shader_upload_seq;
+   if (invalidate_instructions) {
+      qs->shaders.upload_seq = shader_upload_seq;
+      dirty = true;
+   }
+
    if (!dirty)
       return VK_SUCCESS;
 
@@ -165,6 +186,25 @@ nvk_queue_state_update(struct nvk_queue *queue,
       }
    }
 
+   if (invalidate_instructions) {
+      /* One invalidate covers the channel: the 3D class form when the
+       * channel has 3D, the compute class form otherwise, as the proprietary
+       * driver does.  Program addresses need no re-send afterwards: every
+       * command buffer re-emits all of its shaders' addresses before its
+       * first draw (shaders_dirty = ~0 at begin) and every dispatch carries
+       * its program address in the QMD.
+       */
+      if (queue->engines & NVKMD_ENGINE_3D) {
+         P_IMMD(p, NVA097, INVALIDATE_SHADER_CACHES_NO_WFI, {
+            .instruction = INSTRUCTION_TRUE,
+         });
+      } else if (queue->engines & NVKMD_ENGINE_COMPUTE) {
+         P_IMMD(p, NVA0C0, INVALIDATE_SHADER_CACHES_NO_WFI, {
+            .instruction = INSTRUCTION_TRUE,
+         });
+      }
+   }
+
    return nvk_queue_push(queue, p);
 }
 
@@ -215,12 +255,20 @@ nvk_queue_submit_exec(struct nvk_queue *queue,
    if (submit->command_buffer_count > 0) {
       nvk_descriptor_table_flush_map(dev, &dev->images);
       nvk_descriptor_table_flush_map(dev, &dev->samplers);
-      nvk_heap_flush_maps(dev, &dev->shader_heap);
+      assert(!nvk_mem_arena_is_mapped(&dev->shader_heap.arena));
       assert(dev->event_heap.arena.mem_flags & NVKMD_MEM_COHERENT);
 
-      result = nvk_queue_state_update(queue, &queue->state);
-      if (result != VK_SUCCESS)
-         return result;
+      /* The order is the proprietary driver's: copy-engine uploads, then on
+       * this queue an acquire of their completion, then the instruction-cache
+       * invalidate (state push), then the command buffers.  The count is
+       * sampled before the upload queue is flushed, so every upload it
+       * includes is in that flush and ordered before the invalidate by the
+       * wait.  An upload that lands after the sample is flushed too and
+       * invalidated for again at the next submission; it cannot be used by
+       * this one, whose command buffers were recorded before it was called.
+       */
+      const uint32_t shader_upload_seq =
+         p_atomic_read(&dev->shader_heap.upload_seq);
 
       uint64_t upload_time_point;
       result = nvk_upload_queue_flush(dev, &dev->upload, &upload_time_point);
@@ -237,6 +285,11 @@ nvk_queue_submit_exec(struct nvk_queue *queue,
          if (result != VK_SUCCESS)
             goto fail;
       }
+
+      result = nvk_queue_state_update(queue, &queue->state,
+                                      shader_upload_seq);
+      if (result != VK_SUCCESS)
+         return result;
    }
 
    result = nvkmd_ctx_wait(queue->exec_ctx, &queue->vk.base,
