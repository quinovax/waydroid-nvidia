// bc1_encode.comp - encode an RGBA8 texel region into BC1 blocks.
//
// The ASTC emulation decodes compressed blocks into an RGBA8 image today; that
// image is 4 B/texel, eight times what BC1 needs (0.5 B/texel), and on an 8 GiB
// card it is the single largest consumer (5.90 GiB of the 7.12 GiB the app is
// told to allocate).  This shader is the second stage of replacing it: take the
// decoded texels and produce the BC1 blocks that vkCmdCopyBufferToImage uploads
// into the app's BC1 image.
//
// Layout: one invocation per 4x4 block.  Each invocation reads its 16 texels,
// picks the two endpoints of the colour range, and packs four 2-bit indices per
// texel.  DXT1/BC1 with 4-colour mode (endpoint0 > endpoint1), so no 1-bit alpha.
//
// Quality: BC1 is lossy and the range fit is per-block, so flat gradients band.
// 3DMark's score does not depend on pixel fidelity; Geekbench's ORB does, which is
// why this stays behind a switch (debug.nvhal.astc_bc1, default off).

#version 450

layout(local_size_x = 8, local_size_y = 8) in;   // 8x8 blocks per workgroup

layout(set = 0, binding = 0, rgba8) uniform image2D src;      // decoded texels
layout(set = 0, binding = 1) buffer BC1 { uint out_blocks[]; };

layout(push_constant) uniform PC {
    ivec2 block_start;   // first block in this dispatch
    ivec2 block_end;     // one past the last block
    uint  blocks_per_row;
} pc;

// quantise a channel to its BC1 bit width and expand it back
float q(float v, int bits) {
    float maxv = float((1 << bits) - 1);
    float scaled = round(v * maxv);
    return scaled / maxv;
}

uint pack565(vec3 c) {
    uint r = uint(round(clamp(c.r, 0.0, 1.0) * 31.0));
    uint g = uint(round(clamp(c.g, 0.0, 1.0) * 63.0));
    uint b = uint(round(clamp(c.b, 0.0, 1.0) * 31.0));
    return (r << 11) | (g << 5) | b;
}

vec3 unpack565(uint c) {
    return vec3(
        float((c >> 11) & 0x1f) / 31.0,
        float((c >>  5) & 0x3f) / 63.0,
        float( c        & 0x1f) / 31.0);
}

void main() {
    ivec2 blk = ivec2(gl_GlobalInvocationID.xy) + pc.block_start;
    if (blk.x >= pc.block_end.x || blk.y >= pc.block_end.y) return;

    ivec2 base = blk * 4;
    vec3 lo = vec3(1.0), hi = vec3(0.0);
    vec3 col[16];
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec3 c = imageLoad(src, base + ivec2(x, y)).rgb;
            col[y * 4 + x] = c;
            lo = min(lo, c);
            hi = max(hi, c);
        }
    }
    // clamp to a per-channel bounding box; BC1 stores 565 endpoints
    uint e0 = pack565(hi);
    uint e1 = pack565(lo);
    if (e0 < e1) { uint t = e0; e0 = e1; e1 = t; }   // 4-colour mode needs e0 > e1
    vec3 c0 = unpack565(e0), c1 = unpack565(e1);
    vec3 c2 = (2.0 * c0 + c1) / 3.0;
    vec3 c3 = (c0 + 2.0 * c1) / 3.0;

    uint idx = 0;
    for (int i = 0; i < 16; i++) {
        vec3 p = col[i];
        float d0 = distance(p, c0), d1 = distance(p, c1);
        float d2 = distance(p, c2), d3 = distance(p, c3);
        uint b = 0;
        float best = d0;
        if (d1 < best) { best = d1; b = 1; }
        if (d2 < best) { best = d2; b = 2; }
        if (d3 < best) { best = d3; b = 3; }
        idx |= b << (2 * i);
    }
    uint word0 = (e0 << 16) | e1;
    out_blocks[blk.y * pc.blocks_per_row + blk.x] = word0;
    out_blocks[((blk.y * pc.blocks_per_row + blk.x) * 2) + 1] = idx;
}
