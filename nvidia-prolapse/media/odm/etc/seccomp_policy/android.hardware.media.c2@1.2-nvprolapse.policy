# Measured on bionic (Waydroid guest, LineageOS 20 x86_64) 2026-10-23:
#   strace -f -c -p <android.hardware.media.c2@1.2-service-nvprolapse> while decoding
#   H.264, HEVC, VP9 and AV1 (NDK MediaCodec, ByteBuffer output) from the live /odm service.
# Used syscalls (25): read mprotect prctl openat getuid writev ioctl close mmap fstat madvise
# newfstatat futex munmap lseek clone sigaltstack setpriority readlink readlinkat dup
# getdents64 ppoll getrandom fcntl rt_sigprocmask. All are listed below; nothing was missing.
# The service is x86_64-only (the vendor image ships /odm/bin/hw/... x86_64 and lib64), so the
# 32-bit-only names the AOSP policy carries for its dual-ABI service (mmap2, fstat64, stat64,
# statfs64, fstatat64, fstatfs64, getuid32, ugetrlimit, ftruncate64, _llseek) are removed, as
# are the duplicate entries (newfstatat, readlinkat, gettid).
# 64-bit entries not hit in that decode window are kept: they belong to startup/teardown and
# error paths that the attached window does not cover (thread creation, exit, signal return,
# gralloc/AHardwareBuffer allocation).

read: 1
mprotect: 1
prctl: 1
openat: 1
open: 1
getuid: 1
getrlimit: 1
writev: 1
ioctl: 1
close: 1
mmap: 1
fstat: 1
madvise: 1
newfstatat: 1
futex: 1
munmap: 1
faccessat: 1
lseek: 1
clone: 1
sigaltstack: 1
setpriority: 1
restart_syscall: 1
exit: 1
exit_group: 1
rt_sigreturn: 1
readlink: 1
readlinkat: 1
fstatfs: 1
pread64: 1
mremap: 1
dup: 1
set_tid_address: 1
write: 1
nanosleep: 1
sched_setscheduler: 1
uname: 1
memfd_create: 1
ftruncate: 1

# Required by AddressSanitizer
gettid: 1
sched_yield: 1
getpid: 1


# --- nvidia-prolapse additions: the nv_video backend (RM ioctls on /dev/nvidia*, render node
# enumeration, sync_file waits), re-measured in the guest (bionic) 2026-10-23.
ppoll: 1
poll: 1
getdents64: 1
statx: 1
fcntl: 1
getrandom: 1
dup3: 1
rt_sigprocmask: 1
sched_getaffinity: 1

@include /system/etc/seccomp_policy/crash_dump.x86_64.policy
